package dominio;

//el atibuto unico del picaro si tiene el sigilo habilitado su ataque hace daño extra.
public class Picaro extends personajes {
	private boolean sigilo;
//hereda los atributos de personaje pero con el atributo unico de sigilo
	public Picaro(String nombre, int saludActual, int nivel, boolean sigilo) {
		super(nombre, saludActual, nivel);
		this.sigilo = sigilo;
	} 

	public boolean estaEnSigilo() {
		return this.sigilo;
	}

	public void setSigilo(boolean sigilo) {
		this.sigilo = sigilo;
	}

	public int generaAtaque() {
		// si está inhabilitado, super devuelve cero y el extra no suma nada
		int ataque = super.generaAtaque();
		if (this.sigilo) {
			ataque = ataque + ataque / 2; // sigilo: +50% de daño
		}
		return ataque;
	} // fin generaAtaque
	public boolean recibeAtaque(int ataque) {
		// el Pícaro no mitiga daño se aplica segun el golpe
		return super.recibeAtaque(ataque);
	} // fin recibeAtaque

	public String toString() {
		String estado = this.sigilo ? "con sigilo" : "sin sigilo";
		return super.toString() + " Estoy " + estado + ".";
	}

} // fin clase
	        return saludActual;
	    }
	 
	    public int getNivel() {
	        return nivel;
	    }
	 
	    public boolean estaInhabilitado() {
	        return saludActual <= 0;
	    }
	 
	    /**
	     * Calcula el valor del ataque según el nivel del personaje.
	     * Si la salud es cero, el personaje está inhabilitado y el ataque vale cero.
	     */
	    public int generaAtaque() {
	        if (estaInhabilitado()) {
	            return 0;
	        }
	        return nivel * 10;
	    }
	 
	    /**
	     * Calcula el daño recibido y reduce la salud actual.
	     * Si la salud llega a cero, el personaje queda inhabilitado.
	     */
	    public void recibeAtaque(int ataque) {
	        if (estaInhabilitado()) {
	            return;
	        }
	        int dano = Math.max(0, ataque);
	        reducirSalud(dano);
	    }
	 
	    protected void reducirSalud(int dano) {
	        saludActual = Math.max(0, saludActual - dano);
	    }
	 
	    @Override
	    public String toString() {
	        return nombre + " (Nivel " + nivelActual + ", Salud " + saludActual + ")";
	    }
	}
	 
	
